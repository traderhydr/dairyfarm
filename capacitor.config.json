{
  "appId": "com.hydr.dairyfarm",
  "appName": "Dairy Farm Manager",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#064e3b",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "native",
      "style": "LIGHT",
      "initialViewportFitValueHint": "cover"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_cow",
      "iconColor": "#10b981"
    }
  }
}
