# Copy to .env.local and fill in from Supabase -> Project Settings -> API.
# Leave empty to build a local-only app (no accounts, no cloud sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public web address of the hosted app (used in sign-up confirmation / password reset emails).
# Example: https://yourname.github.io/dairyfarm/
VITE_AUTH_REDIRECT_URL=
